# ── Server ───────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
# Dev:  CLIENT_URL=http://localhost:5173
# Prod: CLIENT_URL=https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# ── Database ─────────────────────────────────────────────
# MongoDB Atlas: Whitelist 0.0.0.0/0 in Atlas → Network Access for Render/Railway
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/healthflow?retryWrites=true&w=majority

# ── Auth ─────────────────────────────────────────────────
# Use a long random string: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── Razorpay ─────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Supabase Storage ─────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=medical-records

# ── Twilio (optional) ────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── SMTP (optional) ──────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=HealthFlow <noreply@healthflow.app>
