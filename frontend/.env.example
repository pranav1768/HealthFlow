# ── Development ──────────────────────────────────────────
# In dev, Vite proxies /api → localhost:5000 so VITE_API_URL is NOT needed.
# Leave it blank or omit it entirely for local development.
VITE_API_URL=

# ── Production (Vercel) ───────────────────────────────────
# Set this to your deployed backend URL in the Vercel dashboard → Settings → Environment Variables
# Example: VITE_API_URL=https://healthflow-api.onrender.com
# Do NOT include a trailing slash.
